# Copy to orchestration/airflow/.env (never commit .env). Read by compose.yaml.

# The FHIR server the DAG loads into and extracts from. Default: the throwaway HAPI on port 8090 (throwaway-hapi/),
# never your local HAPI on 8080.
FHIR_BASE=http://host.docker.internal:8090/fhir

# Writable data directory, relative to this folder (or absolute). Mounted over /opt/project/data in the containers.
DATA_DIR=../../data/airflow

# Salt for the pseudonyms and the mart keys: openssl rand -hex 32. Keep it the same every run.
PSEUDONYM_SALT=replace_me

# Optional: Slack or Discord incoming webhook for failed tasks and missed deadlines. Keep it secret.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLEASE
ALERT_WEBHOOK_URL=

# Test switch: once makes the extract task fail on its first try only, always on every try. Empty in normal use.
FORCE_EXTRACT_FAILURE=

# Optional: the BI export to Google Sheets (task export_bi, Variable bi_export_target=sheets). Use a sheet of its own,
# not the one analytics/.env names: this stack holds throwaway data. The key file goes in DATA_DIR/secrets/ (on your
# machine data/airflow/secrets/, ignored by git); the path below is where the containers see it. Both stay empty
# for the default csv target. Never commit them.
BI_SHEET_ID=
BI_CREDENTIALS=/opt/project/data/secrets/bi_service_account.json

# Minutes after a run is queued before the deadline alert fires.
NIGHTLY_DEADLINE_MINUTES=45

# Airflow's own secrets, local only. Each: openssl rand -hex 32 (the Fernet key: see README.md).
AIRFLOW_DB_PASSWORD=replace_me
AIRFLOW__API_AUTH__JWT_SECRET=replace_me
AIRFLOW__API__SECRET_KEY=replace_me
AIRFLOW__CORE__FERNET_KEY=replace_me_with_a_fernet_key
