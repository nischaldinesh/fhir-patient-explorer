# Optional: SMART backend services auth for the Bulk Data client (analytics/bulk.py). Placeholders only.
# Copy the lines you need into your shell or a local .env (never committed). Keep the key outside the repo.
BULK_CLIENT_ID=replace-with-the-client-id-the-server-registered
BULK_PRIVATE_KEY_PATH=/path/outside/the/repo/bulk-client-private-key.pem
BULK_KEY_ID=replace-with-the-kid-of-the-public-key
# BULK_TOKEN_URL=https://example.org/auth/token   # default: token_endpoint of [base]/.well-known/smart-configuration
# BULK_SCOPE=system/*.read

# Optional: the LLM assisted LOINC mapper (terminology/llm_loinc). Put the real key only in analytics/.env, which git
# ignores; it is read from there or the environment and never printed or logged.
ANTHROPIC_API_KEY=replace-with-your-key
# LLM_MODEL=claude-haiku-5-5   # default; the eval also runs claude-sonnet-5-5

# Optional: the BI export to Google Sheets (analytics/export_bi.py --target sheets). The sheet id and the path of a
# service account key (keep the key in data/secrets/, which git ignores). Placeholders only; never commit the real ones.
BI_SHEET_ID=replace-with-the-sheet-id
BI_CREDENTIALS=data/secrets/replace-with-your-key.json
